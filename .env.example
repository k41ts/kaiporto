# Salin file ini jadi .env.local, lalu isi nilainya.

# Dipakai buat canonical URL, sitemap, dan JSON-LD.
NEXT_PUBLIC_SITE_URL=https://zaidan.dev

# Supabase — dashboard → Project Settings → API Keys.
# Ambil kunci PUBLISHABLE (atau anon). JANGAN service_role: itu rahasia,
# dan apa pun yang berawalan NEXT_PUBLIC_ ikut terkirim ke browser.
# Selama dua baris ini kosong, situs baca dari content/site.ts dan Studio
# nampilin panduan setup — bukan error.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
